# Generated: Set, Mod and Get of every attribute, skill and effect stat on the
# player. See docs/commentary/headless_testing.md#mwscript-cases

case attribute_strength
run
player->SetStrength 40
player->ModStrength 5
expect player->GetStrength == 45
end

