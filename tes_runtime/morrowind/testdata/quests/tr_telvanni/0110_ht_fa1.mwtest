# TR House Telvanni: "Seeds for Faruna" (TR_m1_HT_Fa1). Nethan Marys, a Mouth in the Chambers, gives the player the
# Desert Siren seeds through "chores" ("deliver the seeds": 10); Mistress Faruna in Tel Oren's tower takes them (20);
# back in the Chambers, "Yes, the seeds are delivered." (Choice 2) pays out (100, +5 reputation).
# PositionCell stands in for the travel.
# Run: python -m tools.live.test_instance mwtest --cases <this folder> --fast --checkpoints --stop-on-fail --load mwtest_ht_ra1_report --timeout 3600
# See docs/commentary/headless_testing.md#quest-runs

case ht_fa1_start
run
player->PositionCell 275 6977 13830 0 "Port Telvannis, Telvanni Council House: Chambers"
until 600 "TR_m1_T_Nethan_Marys"->GetDistance player < 2500
wait 120
talk TR_m1_T_Nethan_Marys
ask chores
ask deliver the seeds
expect GetJournalIndex TR_m1_HT_Fa1 == 10
expect player->GetItemCount "TR_m1_q67_Fa1_Seeds" == 1
bye
end

case ht_fa1_faruna
run
player->PositionCell 7390 4300 16170 0 "Tel Oren, Tower"
until 600 "TR_m1_T_Faruna"->GetDistance player < 600
wait 120
talk TR_m1_T_Faruna
ask deliver the seeds
expect GetJournalIndex TR_m1_HT_Fa1 == 20
bye
end

case ht_fa1_done
run
player->PositionCell 275 6977 13830 0 "Port Telvannis, Telvanni Council House: Chambers"
until 600 "TR_m1_T_Nethan_Marys"->GetDistance player < 2500
wait 120
talk TR_m1_T_Nethan_Marys
ask deliver the seeds
choose 2
expect GetJournalIndex TR_m1_HT_Fa1 == 100
bye
end
