# TR House Telvanni: "Fresh Delivery" (TR_m1_HT_Fa2). Nethan Marys's "chores" adds "new slaves"; agreeing (Choice 1)
# hands over twelve gems for Naral Dunden in Port Telvannis (10, starts TR_m1_q67_Fa2_gscript1: after three game
# hours a scamp comes for the gems and fails the quest). Naral takes the gems (20); Nethan pays (200, +5 reputation).
# Position stands in for the walk to Naral, who stands outdoors in Port Telvannis.
# Run: python -m tools.live.test_instance mwtest --cases <this folder> --fast --checkpoints --stop-on-fail --load mwtest_ht_rathra_q6_done --timeout 3600
# See docs/commentary/headless_testing.md#quest-runs

case ht_fa2_start
run
player->PositionCell 275 6977 13830 0 "Port Telvannis, Telvanni Council House: Chambers"
until 600 "TR_m1_T_Nethan_Marys"->GetDistance player < 2500
wait 120
talk TR_m1_T_Nethan_Marys
ask chores
ask new slaves
choose 1
expect GetJournalIndex TR_m1_HT_Fa2 == 10
expect player->GetItemCount "ingred_diamond_01" >= 3
bye
end

case ht_fa2_naral
run
player->Position 353300 141960 1660 0
until 600 "TR_m1_Naral_Dunden"->GetDistance player < 1000
wait 60
talk TR_m1_Naral_Dunden
ask new slaves
expect GetJournalIndex TR_m1_HT_Fa2 == 20
bye
end

case ht_fa2_done
run
player->PositionCell 275 6977 13830 0 "Port Telvannis, Telvanni Council House: Chambers"
until 600 "TR_m1_T_Nethan_Marys"->GetDistance player < 2500
wait 120
talk TR_m1_T_Nethan_Marys
ask new slaves
expect GetJournalIndex TR_m1_HT_Fa2 == 200
bye
end
