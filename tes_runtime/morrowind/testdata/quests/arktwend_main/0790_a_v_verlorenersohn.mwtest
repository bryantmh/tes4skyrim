end

# The prospector's chamber, the deep shaft and the gorges of Grul.
case sohn_grul
run
player->PositionCell 24 315 -45 0 "Prospector Chamber"
until 300 GetJournalIndex A_V_VerlorenerSohn == 28
run
player->PositionCell 3285 -17601 124029 0 "Deep Shaft"
until 300 GetJournalIndex A_V_VerlorenerSohn == 29
run
player->PositionCell 6 5011 -1137 0 "Subterranean Gorges of Grul"
until 300 GetJournalIndex A_V_VerlorenerSohn == 30
expect Zwergenvar == 1
run
player->PositionCell 50 -55 -2180 0 "Subterranean Gorges of Grul"
until 300 GetJournalIndex A_V_VerlorenerSohn == 31
end

# The Demon King in the crystal hall; he carries the star key.
case sohn_demon_king
run
player->PositionCell 32 -1700 361 0 "Crystal Hall"
until 600 MenuMode == 1
wait 60
bye
expect GetJournalIndex A_V_VerlorenerSohn == 32
console 0533F6FE.damageav health 100000
until 600 GetJournalIndex A_V_VerlorenerSohn == 33
expect Zwergenvar == 2
console 0533F6FE.removeallitems player
until 300 player->GetItemCount Key_Sternen == 1
end

# Mauragin is alive, and gives up the black stones.
case sohn_mauragin
run
player->PositionCell -588 -1250 410 0 "Crystal Hall"
until 600 MenuMode == 1
wait 60
ask defeated the Demon King
choose 1
choose 3
choose 4
choose 5
bye
expect GetJournalIndex A_V_VerlorenerSohn == 35
expect player->GetItemCount a_SchwarzerStein01 == 10
end

# Out of the crystal hall through the ancient temple to the gorges, where the
# star key opens the lift up to Naremar.
case sohn_lift
# Mauragin follows: the player walks to each door and on to the airship hall.
defend
walk -150 -2790 -200
until 3000 "Mauragin01"->GetDistance player < 600
activate 0533CB28
until 600 GetPCCell "Arpk, Ancient Temple" == 1
walk -137 478 -160
until 3000 "Mauragin01"->GetDistance player < 600
activate 054BEC3A
until 600 GetPCCell "Subterranean Gorges of Grul" == 1
walk 300 1700 -2176
until 3000 "Mauragin01"->GetDistance player < 600
activate 052D74DF
until 300 GetJournalIndex A_V_VerlorenerSohn == 36
until 300 GetPCCell "Naremar" == 1
walk 4425 -1269 12792
until 3000 "Mauragin01"->GetDistance player < 600
until 300 GetJournalIndex A_V_VerlorenerSohn == 37
until 600 MenuMode == 1
wait 60
bye
end

# The old airship: Mauragin wonders whether it runs, then three cranks and
# the launch lever.
case sohn_airship
defend
# Mauragin follows: the player walks to the gangway door, aboard, and to the cranks.
walk 3985 -4739 12620
# He comes aboard only from close by.
until 3000 "Mauragin01"->GetDistance player < 600
activate 05931B03
until 600 GetPCCell "Old Airship" == 1
walk -384 -1029 1150
until 300 GetJournalIndex A_V_VerlorenerSohn == 38
# Mauragin greets once he is within 500 of the player.
until 3000 "Mauragin01"->GetDistance player < 500
until 600 MenuMode == 1
wait 60
bye
# The cranks stand past the end of the deck's navmesh; the walk goes to its end.
walk -238 -2771 1152
until 3000 "Mauragin01"->GetDistance player < 600
activate 05E29AEF
until 300 Zwergenvar == 3
activate 05A4C1FC
until 300 Zwergenvar == 4
activate 05465FD3
until 300 Zwergenvar == 5
activate 05ACE2F2
until 300 GetJournalIndex A_V_VerlorenerSohn == 39
until 3000 "Mauragin01"->GetDistance player < 500
until 600 MenuMode == 1
wait 60
bye
expect Zwergenvar == 6
end

# Below deck the ship cannot be steered; Mauragin cannot stop the crash.
case sohn_crash
# Mauragin stays at the helm once the ship is up (his greeting sets AiWander 0), so
# nobody follows; the player walks the deck by the game's own pathing, which steps
# round him in the narrow walkway.
walk -368 950 1154
until 300 GetJournalIndex A_V_VerlorenerSohn == 40
talk Mauragin01
bye
expect GetJournalIndex A_V_VerlorenerSohn == 47
walk -387 673 1154
until 300 Zwergenvar == 7
until 600 MenuMode == 1
wait 60
bye
end

