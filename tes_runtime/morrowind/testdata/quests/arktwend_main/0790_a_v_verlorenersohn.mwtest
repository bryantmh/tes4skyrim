# Chapter V, the lost son: King Olim of Northron asks the player to find his
# son Mauragin. His diary pages lead over the Norifjon mountains and down
# through Gotros and the worm tunnels to the Demon King's crystal hall; the
# two escape in an old airship and come home from the far north.
# Position stands in for the walks Mauragin takes no part in and damage for
# the fights; once he follows, the player walks and takes the doors. Ref
# FormIDs carry Arktwend's slot 05.
# 🛑 Mauragin's landing line writes journal 47 before the markers write 41-46.
# Journal only raises the index (OpenMW Quest::addEntry), so from there on the
# cases follow Zwergenvar, which is what the authored scripts read.
# Run: python -m tools.live.test_instance mwtest --cases <this folder> --fast --checkpoints --stop-on-fail --from sohn_olim
# See docs/commentary/headless_testing.md#quest-runs

# King Olim asks the player to search for his son.
case sohn_olim
run
player->PositionCell -4095 -170 458 0 "Great Hall of Northron"
talk ZwergenKonigOlim01
ask search for him?
choose 1
choose 4
bye
expect GetJournalIndex A_V_VerlorenerSohn == 2
end

# The guard at the northern edge saw Mauragin pass, and a group after him. He
# stands on a steep slope where a dropped player can slide out of his range
# and into the child's, whose greeting skips ahead, so once the cell loads the
# player stands just above him, read off his position.
case sohn_guard
run
player->Position 136538 -35112 722 180
until 300 "NordrandWache01"->GetDistance player < 4000
run
set TestResult to ( "NordrandWache01"->GetPos x )
player->SetPos x TestResult
set TestResult to ( ( "NordrandWache01"->GetPos y ) + 100 )
player->SetPos y TestResult
set TestResult to ( ( "NordrandWache01"->GetPos z ) + 20 )
player->SetPos z TestResult
until 600 MenuMode == 1
wait 60
ask into the mountains
choose 1
choose 2
choose 3
choose 4
bye
expect GetJournalIndex A_V_VerlorenerSohn == 4
end

# A child wants to be an adventurer too, and runs off after a wolf.
case sohn_child
# Steered up the cliff path with the child following: big governor steps stick the player and lose the child.
pace 10
run
player->Position 135607 -37130 74 0
until 600 MenuMode == 1
wait 60
bye
expect GetJournalIndex A_V_VerlorenerSohn == 5
# The child follows (AIFollow) from journal 5 to 6, so the player walks her up to the wolf along the
# navmesh; the wolf comes down to meet them, and at 6 (its death) she greets, hands over the diary
# page and is disabled, which ends the waits for her wherever on the route that happens.
defend
steer 135653 -37587 76
bye if open
steer 134063 -37586 76
bye if open
steer 134021 -37651 76
bye if open
steer 133963 -37658 76
bye if open
until 3000 "NordrandKind"->GetDistance player < 600 + 100000 * "NordrandKind"->GetDisabled
steer 133663 -37567 83
bye if open
steer 132774 -37774 249
bye if open
steer 132690 -37596 372
bye if open
steer 132699 -37562 381
bye if open
until 3000 "NordrandKind"->GetDistance player < 600 + 100000 * "NordrandKind"->GetDisabled
steer 132667 -37519 417
bye if open
steer 132597 -37576 441
bye if open
steer 132390 -37523 575
bye if open
steer 132335 -37540 599
bye if open
until 3000 "NordrandKind"->GetDistance player < 600 + 100000 * "NordrandKind"->GetDisabled
steer 131684 -38120 972
bye if open
steer 131186 -38209 1248
bye if open
steer 131061 -38235 1325
bye if open
steer 130779 -38161 1482
bye if open
until 3000 "NordrandKind"->GetDistance player < 600 + 100000 * "NordrandKind"->GetDisabled
steer 130643 -38212 1561
bye if open
steer 130084 -38305 1915
bye if open
steer 129119 -37966 2731
bye if open
steer 127222 -37818 3727
bye if open
until 3000 "NordrandKind"->GetDistance player < 600 + 100000 * "NordrandKind"->GetDisabled
steer 126886 -37906 3824
bye if open
steer 126445 -37864 4028
bye if open
steer 126079 -37867 4202
bye if open
steer 125948 -37856 4232
bye if open
until 3000 "NordrandKind"->GetDistance player < 600 + 100000 * "NordrandKind"->GetDisabled
steer 125714 -37851 4310
bye if open
steer 125005 -37775 4560
bye if open
steer 124646 -37689 4703
bye if open
steer 124489 -37667 4752
bye if open
until 3000 "NordrandKind"->GetDistance player < 600 + 100000 * "NordrandKind"->GetDisabled
steer 124119 -37565 4853
bye if open
steer 123088 -37267 5259
bye if open
steer 123031 -37329 5241
bye if open
steer 122967 -37331 5254
bye if open
until 3000 "NordrandKind"->GetDistance player < 600 + 100000 * "NordrandKind"->GetDisabled
steer 122805 -37215 5324
bye if open
steer 121700 -37350 5523
bye if open
until 3000 "NordrandKind"->GetDistance player < 600 + 100000 * "NordrandKind"->GetDisabled
until 3000 GetJournalIndex A_V_VerlorenerSohn == 6
until 600 "NordrandKind"->GetDisabled == 1
bye if open
end

# On through the mountains to the astronomer's tower.
case sohn_tower
# Over the ridge along the navmesh from where sohn_child's route ends: a Position onto the mountain
# landed before its ground loaded, and the player slid 5000 down into the valley.
steer 120473 -37314 5685
steer 120025 -37269 5748
steer 119254 -37355 5848
steer 118816 -37271 5911
steer 118720 -37266 5922
steer 116830 -38786 6400
steer 115897 -40437 6794
steer 115338 -40548 6766
steer 115136 -41472 6225
steer 114589 -42536 5341
steer 114000 -43446 5275
steer 113720 -44300 5027
until 300 GetJournalIndex A_V_VerlorenerSohn == 7
run
player->Position 112252 -27330 14110 0
activate 052EF990
until 300 GetJournalIndex A_V_VerlorenerSohn == 8
end

# Mauragin's diary, page 10, in the Ice Hall.
case sohn_page10
run
player->PositionCell 342 680 -949 0 "Ice Hall"
activate 05305622
take 05305622
close Book Menu
until 300 GetJournalIndex A_V_VerlorenerSohn == 9
end

# The summit of Norifjon, and page 11.
case sohn_summit
run
player->Position 119195 -28900 26981 0
until 300 GetJournalIndex A_V_VerlorenerSohn == 10
activate 05D61D77
take 05D61D77
close Book Menu
until 300 GetJournalIndex A_V_VerlorenerSohn == 11
end

# Down to the buried road to Gotros, and page 12 in its air shaft.
case sohn_airshaft
run
player->Position 101747 -30900 374 0
until 300 GetJournalIndex A_V_VerlorenerSohn == 12
run
player->PositionCell -9425 4660 -369 0 "Gotros, Air Shaft"
activate 0532ABCA
take 0532ABCA
close Book Menu
until 300 GetJournalIndex A_V_VerlorenerSohn == 13
end

# The air shaft gives way into the Spider Cavern; a hermit's bones lie there.
case sohn_spider_cavern
run
player->PositionCell -6473 3800 -383 0 "Gotros, Air Shaft"
until 300 GetJournalIndex A_V_VerlorenerSohn == 14
until 300 GetPCCell "Spider Cavern" == 1
run
player->PositionCell 1080 6800 -637 0 "Spider Cavern"
until 300 GetJournalIndex A_V_VerlorenerSohn == 15
run
player->PositionCell 692 7000 -597 0 "Spider Cavern"
until 300 GetJournalIndex A_V_VerlorenerSohn == 16
end

# Irfl in the Upper Mines has seen the group of dwarves.
case sohn_irfl
run
player->PositionCell 1618 -3150 -1015 0 "Upper Mines"
until 600 MenuMode == 1
wait 60
ask group of dwarves
choose 1
choose 2
bye
expect GetJournalIndex A_V_VerlorenerSohn == 18
end

# The guard of Gotros, and page 14 in the city.
case sohn_gotros
run
player->PositionCell -5098 -1150 66 0 "Gotros"
until 600 MenuMode == 1
wait 60
bye
expect GetJournalIndex A_V_VerlorenerSohn == 19
run
player->PositionCell 1786 9800 269 0 "Gotros"
activate 055F1671
take 055F1671
close Book Menu
until 300 GetJournalIndex A_V_VerlorenerSohn == 20
end

# Through the spore cave, the depleted mine and the worm tunnels.
case sohn_tunnels
run
player->PositionCell -2547 2530 -1028 0 "Fungal Spore Cave"
until 300 GetJournalIndex A_V_VerlorenerSohn == 21
run
player->PositionCell -967 1994 -321 0 "Depleted Ore Mine"
until 300 GetJournalIndex A_V_VerlorenerSohn == 22
run
player->PositionCell 826 2039 -238 0 "Worm Tunnel"
until 300 GetJournalIndex A_V_VerlorenerSohn == 23
run
player->PositionCell 1625 2339 -641 0 "Worm Tunnel"
until 300 GetJournalIndex A_V_VerlorenerSohn == 24
end

# The worm crypt, and page 16 back in the tunnels.
case sohn_crypt
run
player->PositionCell 3182 7817 8971 0 "Worm Crypt"
until 300 GetJournalIndex A_V_VerlorenerSohn == 25
run
player->PositionCell 7298 7307 9168 0 "Worm Crypt"
until 300 GetJournalIndex A_V_VerlorenerSohn == 26
run
player->PositionCell 4796 -540 -1282 0 "Worm Tunnel"
activate 05B62B62
take 05B62B62
close Book Menu
