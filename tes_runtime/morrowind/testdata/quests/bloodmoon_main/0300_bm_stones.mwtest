# Tharsten rewards the restored Oneness with the Mace of Aevar Stonesinger.
case bm_stones_done
until 300 GetJournalIndex BM_Stones == 80
run
player->PositionCell -27 -20 -244 180 "Skaal Village, The Greathall"
until 600 GetPCCell "Skaal Village, The Greathall" == 1
talk tharsten heart-fang
ask restore the power of the Skaal
expect GetJournalIndex BM_Stones == 100
expect player->GetItemCount BM_Mace_Aevar_UNI == 1
bye
end
