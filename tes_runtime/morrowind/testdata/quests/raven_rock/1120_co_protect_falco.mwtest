# Bloodmoon "Protect Falco", Falco's side: three days after the guards, away
# from Raven Rock (ColonyState 20), Falco fears for his life. Ten seconds after
# he tells the player (10, ColonyAssassin), Baslod attacks him and flees (20);
# Capiton Popillius and Cimber Valerius then attack Falco, and their deaths log
# 100. Falco closes it (110); his death would fail it (200). The player stands
# at Falco's side and follows him through the fight: he charges the assassins,
# ColonyFalco force-greets a player more than 512 units off, and ColonyAssassin
# waits out the menu. The kills stand in for the fight.
# Run: python -m tools.live.test_instance mwtest --cases <this folder> --fast --checkpoints --stop-on-fail --load mwtest_co_hiring_guards --timeout 2400
# See docs/commentary/headless_testing.md#quest-runs

case co_protect_falco
run
player->PositionCell -450 -142 330 0 "Raven Rock, Vacant House"
activate 0676D5A3
sleep 24
activate 0676D5A3
sleep 24
activate 0676D5A3
sleep 24
activate 0676D5A3
sleep 24
run
player->PositionCell 3504 4553 16407 0 "Fort Frostmoth, Imperial Cult Shrine"
until 600 ColonyState == 20
run
player->Position -199700 160300 1000 0
until 600 "Falco Galenus"->GetDistance player < 400
talk Falco Galenus
ask assignment
ask assassinated
expect GetJournalIndex CO_12 == 10
follow Falco Galenus
bye
until 900 GetJournalIndex CO_12 == 20
run
set TestResult to ( "Falco Galenus"->GetPos x )
player->SetPos x TestResult
set TestResult to ( ( "Falco Galenus"->GetPos y ) + 60 )
player->SetPos y TestResult
set TestResult to ( ( "Falco Galenus"->GetPos z ) + 20 )
player->SetPos z TestResult
until 300 "Falco Galenus"->GetDistance player < 150
# The assassins die before Baslod: ColonyAssassin writes 100 only outside menus, and while CO_12 is under 100
# Falco force-greets a player who strays past 512 in the fight, a greeting nothing here closes.
until 900 "Capiton Popillius"->GetDisabled == 0
until 900 "Cimber Valerius"->GetDisabled == 0
console 067BC8FB.kill
console 063BD04C.kill
until 600 GetJournalIndex CO_12 == 100
console 0654C18C.kill
follow
expect "Falco Galenus"->GetHealth > 0
run
player->Position -199700 160300 1000 0
until 600 "Falco Galenus"->GetDistance player < 400
talk Falco Galenus
ask assassinated
expect GetJournalIndex CO_12 == 110
bye
end
