# Thieves Guild: the Bal Molagmer, Gentleman Jim Stacey's charity thefts (Stacey = 05D48791). "Bal Molagmer"
# hands over the gloves (TG_SS_Generosity1 1); worn, their gloveScript sets TGglove, which Stacey and the
# recipients test. Then, in order: Hlervu Locket (Braynas Hlervu outside Ald'ruhn: "Yes, take it." 3, the Bal
# Molagmer answer 2: 55), corruption (Yngling Half-Troll's ledger to Stacey: 100), forged land deed (Indrele
# Rathryon, Seyda Neen: 3, 2), Enamor (the blade and note into Salyn Sarethi's chest: staceyScript's enamorInChest),
# Brallion's Ring (Ilmeni Dren, St. Delyn: 3, 2), history books (Odral Helvi's set to Vala Catraso, Ald'ruhn Mages
# Guild: 1, 11), Dwemer goblet (Danso Indules outside the High Fane: 3, 2). Reputation 5 each.
# AddItem stands in for the thefts; RemoveItem + the chest's AddItem for the player putting Enamor back.
# Run: python -m tools.live.test_instance --instance 2 mwtest --cases <this folder> --fast --checkpoints --stop-on-fail --load mwtest_a1_11_report --timeout 3600
# See docs/commentary/headless_testing.md#quest-runs

case ss_gloves
run
player->PositionCell 6452 -800 -244 0 "Vivec, Simine Fralinie: Bookseller"
until 300 GetPCCell "Vivec, Simine Fralinie: Bookseller" == 1
approach 05D48791
talk stacey
ask Bal Molagmer
expect GetJournalIndex TG_SS_Generosity1 == 1
expect player->GetItemCount Common_Glove_R_BalMolagmer == 1
bye
run
player->Equip Common_Glove_R_BalMolagmer
player->Equip Common_Glove_L_BalMolagmer
until 300 TGglove == 1
end

case ss_hlervu_locket
approach 05D48791
talk stacey
ask Bal Molagmer
ask Hlervu Locket
expect GetJournalIndex TG_SS_Generosity1 == 10
bye
run
player->AddItem exquisite_amulet_hlervu1 1
player->Position -7301 52950 2379 0
until 300 player->GetDistance "braynas hlervu" < 2000
approach 05CB3BE1
talk braynas hlervu
ask Hlervu Locket
choose 3
choose 2
expect GetJournalIndex TG_SS_Generosity1 == 55
bye
run
player->PositionCell 6452 -800 -244 0 "Vivec, Simine Fralinie: Bookseller"
until 300 GetPCCell "Vivec, Simine Fralinie: Bookseller" == 1
approach 05D48791
talk stacey
ask Hlervu Locket
expect GetJournalIndex TG_SS_Generosity1 == 100
bye
end

case ss_yngling
approach 05D48791
talk stacey
ask Bal Molagmer
ask corruption
expect GetJournalIndex TG_SS_Yngling == 10
bye
run
player->AddItem bk_YnglingLedger 1
approach 05D48791
talk stacey
ask corruption
choose 1
expect GetJournalIndex TG_SS_Yngling == 100
bye
end

case ss_land_deed
approach 05D48791
talk stacey
ask Bal Molagmer
ask forged land deed
expect GetJournalIndex TG_SS_Generosity2 == 10
bye
run
player->AddItem bk_IndreleDeed 1
player->Position -12181 -71450 98 0
until 300 player->GetDistance "indrele rathryon" < 2000
approach 05C357F1
talk indrele rathryon
ask forged land deed
choose 3
choose 2
expect GetJournalIndex TG_SS_Generosity2 >= 50
bye
run
player->PositionCell 6452 -800 -244 0 "Vivec, Simine Fralinie: Bookseller"
until 300 GetPCCell "Vivec, Simine Fralinie: Bookseller" == 1
approach 05D48791
talk stacey
ask forged land deed
expect GetJournalIndex TG_SS_Generosity2 == 100
bye
end

case ss_enamor
approach 05D48791
talk stacey
ask Bal Molagmer
ask Enamor
expect GetJournalIndex TG_SS_Enamor == 10
bye
run
player->RemoveItem Glass_Dagger_Enamor 1
player->RemoveItem bk_Enamor 1
"de_p_chest_02salynsaret"->AddItem Glass_Dagger_Enamor 1
"de_p_chest_02salynsaret"->AddItem bk_Enamor 1
until 300 stacey.enamorInChest == 1
approach 05D48791
talk stacey
ask Enamor
expect GetJournalIndex TG_SS_Enamor == 100
bye
end

