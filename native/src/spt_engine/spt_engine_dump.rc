// Version resource for spt_engine_dump.exe.  An exe with no version info is
// one of the signals antivirus heuristics weigh against unsigned binaries.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "TESConversion"
            VALUE "FileDescription",  "SpeedTree geometry dump tool for the TES4-to-TES5 converter"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "spt_engine_dump"
            VALUE "OriginalFilename", "spt_engine_dump.exe"
            VALUE "ProductName",      "TESConversion"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
