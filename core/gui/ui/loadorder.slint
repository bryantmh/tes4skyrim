// Step 4: what is built once for every converted game together, and distant LOD per worldspace.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Ui, LoadItem } from "state.slint";
import { Btn, Box, Divider, SectionLabel, Heading, Muted, Pill, Tick } from "widgets.slint";

component ItemList {
    in property <[LoadItem]> items;
    Box {
        VerticalLayout {
            for item[i] in items: VerticalLayout {
                if i > 0: Divider { }
                HorizontalLayout {
                    padding: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text { text: item.title; font-weight: 600; color: Theme.fg; vertical-alignment: center; }
                            if item.tag != "": Pill { text: item.tag; tone: "info"; }
                        }
                        Text { text: item.detail; font-size: 13px; color: Theme.muted; wrap: word-wrap; }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        horizontal-stretch: 0;
                        if item.toggle: HorizontalLayout {
                            spacing: 6px;
                            Tick { checked: item.include; label: "Include " + item.title; toggled(on) => { Ui.lo-include(item.key, on); } }
                            Text { text: "Include"; font-size: 13px; color: Theme.fg; vertical-alignment: center; }
                        }
                        HorizontalLayout { width: 110px; alignment: start; VerticalLayout { alignment: center; Pill { text: item.status; tone: item.tone; } } }
                        HorizontalLayout {
                            width: 120px;
                            alignment: end;
                            if item.action != "": VerticalLayout { alignment: center; Btn { text: item.action; small: true; clicked => { Ui.lo-action(item.key); } } }
                        }
                    }
                }
                if item.key == "lod" && item.include: VerticalLayout {
                    padding: 12px;
                    padding-top: 0px;
                    spacing: 6px;
                    if Ui.worlds.length > 0: HorizontalLayout {
                        spacing: 6px;
                        padding-left: 4px;
                        Text { text: "Worldspaces to build"; font-size: 12.5px; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; }
                        Btn { text: "All"; small: true; clicked => { Ui.lod-all-worlds(true); } }
                        Btn { text: "None"; small: true; clicked => { Ui.lod-all-worlds(false); } }
                    }
                    if Ui.worlds.length > 0: Box {
                        VerticalLayout {
                            for w[j] in Ui.worlds: Rectangle {
                                TouchArea { mouse-cursor: pointer; clicked => { Ui.lod-tick-world(j, !w.checked); } }
                                Divider { y: 0; width: parent.width; visible: j > 0; }
                                HorizontalLayout {
                                    padding: 8px;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    Tick { checked: w.checked; label: w.name; toggled(on) => { Ui.lod-tick-world(j, on); } }
                                    Text { text: w.name; color: Theme.fg; font-size: 13px; horizontal-stretch: 2; preferred-width: 0px; vertical-alignment: center; overflow: elide; }
                                    Text { text: w.plugins; color: Theme.muted; font-size: 12.5px; horizontal-stretch: 3; preferred-width: 0px; vertical-alignment: center; overflow: elide; }
                                    HorizontalLayout { width: 170px; alignment: end; VerticalLayout { alignment: center; Pill { text: w.status; tone: w.tone; } } }
                                }
                            }
                        }
                    }
                    if Ui.worlds.length == 0 && Ui.lod-why != "": Muted { text: Ui.lod-why; }
                }
            }
        }
    }
}

export component LoadOrderView {
    ScrollView {
        content-width: self.visible-width;
        VerticalLayout {
            alignment: start;
            padding: 32px;
            padding-top: 24px;
            spacing: 8px;
            HorizontalLayout {
                VerticalLayout {
                    Heading { text: "Shared mods"; }
                    Muted { text: "Built once and used by every converted game."; }
                }
                HorizontalLayout {
                    alignment: end;
                    Btn { text: Ui.build-label; kind: "primary"; enabled: Ui.build-enabled && !Ui.running; clicked => { Ui.build-ready(); } }
                }
            }
            ItemList { items: Ui.lo-items; }
            SectionLabel { text: "OPTIONAL"; }
            ItemList { items: Ui.lo-extras; }
        }
    }
}
