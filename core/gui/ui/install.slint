// Step 5: install the finished mods with a mod manager, in order, and start the game.
// The switch row and the folder row keep their size whatever way is chosen, so switching moves nothing.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Ui } from "state.slint";
import { Btn, Box, Divider, SectionLabel, Heading, Muted, Pill, Seg, Tick, TrashBtn } from "widgets.slint";

export component InstallView {
    ScrollView {
        content-width: self.visible-width;
        VerticalLayout {
            alignment: start;
            padding: 32px;
            padding-top: 24px;
            spacing: 10px;
            Heading { text: "Install & play"; }
            Box {
                tint: Theme.surface-2;
                VerticalLayout {
                    HorizontalLayout {
                        height: 56px;
                        padding-left: 16px;
                        padding-right: 14px;
                        spacing: 12px;
                        Text { text: "Install with"; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 0; }
                        VerticalLayout { alignment: center; horizontal-stretch: 0; Seg { options: Ui.manager-options; current: Ui.manager; selected(i) => { Ui.set-manager(i); } } }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: end;
                            if Ui.launch-label != "": VerticalLayout { alignment: center; Btn { text: Ui.launch-label; small: true; clicked => { Ui.launch(); } } }
                        }
                    }
                    Divider { }
                    HorizontalLayout {
                        height: 48px;
                        padding-left: 16px;
                        padding-right: 14px;
                        spacing: 12px;
                        Text { text: Ui.manager-where; font-family: Theme.mono-font; font-size: 12.5px; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 3; preferred-width: 0px; overflow: elide; }
                        Text { text: Ui.manager-detail; font-size: 12.5px; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 2; preferred-width: 0px; overflow: elide; }
                        VerticalLayout { alignment: center; Btn { text: Ui.folder-label; small: true; enabled: Ui.folder-enabled; clicked => { Ui.open-target(); } } }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Btn { text: "Select all"; clicked => { Ui.install-select(true); } }
                Btn { text: "Select none"; clicked => { Ui.install-select(false); } }
                HorizontalLayout {
                    alignment: end;
                    if Ui.install-label != "": Btn { text: Ui.install-label; kind: "primary"; enabled: Ui.install-enabled && !Ui.running; clicked => { Ui.install(); } }
                }
            }
            Box {
                height: max(min(Ui.installs.length * 54px, 380px), 44px);
                ScrollView {
                    content-width: self.visible-width;
                    VerticalLayout {
                    for row[i] in Ui.installs: VerticalLayout {
                        if i > 0: Divider { }
                        HorizontalLayout {
                            padding: 10px;
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            VerticalLayout { alignment: center; Tick { checked: row.checked; label: "Include " + row.name; toggled(on) => { Ui.install-toggle(i, on); } } }
                            Text { text: row.order; width: 20px; font-family: Theme.display-font; color: Theme.muted; horizontal-alignment: right; vertical-alignment: center; }
                            Text { text: row.name; font-family: Theme.mono-font; font-size: 12.5px; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 3; preferred-width: 0px; overflow: elide; }
                            Text { text: row.detail; font-size: 12.5px; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 2; preferred-width: 0px; overflow: elide; }
                            VerticalLayout { width: 90px; alignment: center; HorizontalLayout { alignment: start; Pill { text: row.status; tone: row.tone; } } }
                            VerticalLayout {
                                width: 28px;
                                min-height: 28px;
                                alignment: center;
                                if row.removable: TrashBtn { label: "Uninstall"; clicked => { Ui.uninstall(i); } }
                            }
                        }
                    }
                    if Ui.installs.length == 0: Muted { text: "Nothing converted yet. Convert a game first."; }
                    }
                }
            }
            SectionLabel { text: "AFTER PLAYING"; }
            Box {
                HorizontalLayout {
                    padding: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    VerticalLayout {
                        Text { text: "Navmesh editor"; font-weight: 600; color: Theme.fg; }
                        Muted { text: "Pins where NPCs should or shouldn't walk. Used by the next Import."; }
                    }
                    HorizontalLayout { alignment: end; Btn { text: "Open"; small: true; clicked => { Ui.open-dialog("navmesh"); } } }
                }
            }
        }
    }
}
