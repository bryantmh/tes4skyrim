{
    "explorer.excludeGitIgnore": false,
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.papyrus": true,
        "**/.ruff_cache": true,
    },
    "files.watcherExclude": {
        "**/output/**": true,
        "**/export/**": true,
        "**/temp/**": true,
        "**/references/**": true,
    },
    "python.analysis.exclude": [
        "output",
        "export",
        "temp",
        "references",
        "external",
        "native",
        "**/__pycache__",
    ],
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.indexing": false,
    "diffEditor.diffAlgorithm": "legacy"
}
